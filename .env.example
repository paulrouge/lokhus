# Copy to .env (gitignored) and fill in. The server reads it on start.

# Postgres connection string. Leave empty to use the local SQLite file (data/app.db).
DATABASE_URL=

# Optional. Tests default to DATABASE_URL (outside hosted mode) and only use throwaway lokhus_test_* schemas.
TEST_DATABASE_URL=

# self (default): you run Lokhus for yourself. hosted: open sign-up on your domain.
LOKHUS_MODE=self

# Hosted mode only
LOKHUS_HOSTS=
LOKHUS_BIND=127.0.0.1
LOKHUS_TRUST_PROXY=0

# Web app (read at build time)
VITE_WC_PROJECT_ID=
